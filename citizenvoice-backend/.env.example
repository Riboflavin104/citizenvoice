# Project Settings -> API in Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key — SECRET. Only ever used server-side (this backend).
# Bypasses RLS, so never send this to the browser/frontend.
SUPABASE_SERVICE_KEY=your-service-role-key

# anon/publishable key — safe to put in frontend JS. Used here only to
# verify tokens the frontend sends us; respects RLS.
SUPABASE_ANON_KEY=your-anon-key

EMBEDDING_MODEL=embed-multilingual-v3.0
DUPLICATE_THRESHOLD=0.15
